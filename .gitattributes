* text=auto eol=lf

# Never commit weights. Without git-lfs installed the filter fails the add,
# which is the point: it stops an accidental multi-GB model in history.
*.gguf filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

*.png binary
*.gif binary
*.ico binary
*.svg text
*.tape text
