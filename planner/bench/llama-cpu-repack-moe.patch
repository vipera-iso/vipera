 namespace ggml::cpu::repack {
+// vipera: repacking a 3D MoE expert tensor copies it into anonymous memory, which the
+// kernel cannot reclaim. A model whose expert pool exceeds RAM therefore cannot load at
+// all -- it is OOM-killed during load -- instead of streaming the experts from disk.
+// Skipping this one branch keeps every 2D weight repacked (fast kernels, and only ~1 GiB
+// of anonymous memory: the non-expert weights) while the expert slabs stay file-backed
+// and reclaimable. Measured on Qwen3-30B-A3B with `bench/moe_spill.py`: with the branch,
+// 3/3 runs OOM-killed; with `-nr` (all repacking off), 3/3 run at 5.6 tok/s.
+//
+// GGML_CPU_REPACK_MOE=0 disables it. The default keeps the upstream behaviour, so this
+// changes nothing unless it is asked for.
+static bool ggml_cpu_repack_moe_enabled() {
+    const char * env = getenv("GGML_CPU_REPACK_MOE");
+    return !(env && env[0] == '0');
+}
