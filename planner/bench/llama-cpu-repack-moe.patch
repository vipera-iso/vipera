@@ -5206,6 +5222,7 @@ class extra_buffer_type : ggml::cpu::extra_buffer_type {
             //}
             // may be possible if Q8_0 packed...
         } else if (op->op == GGML_OP_MUL_MAT_ID
+                && ggml_cpu_repack_moe_enabled()
