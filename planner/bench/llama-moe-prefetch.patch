+    // vipera: give expert e of layer il a slot *without* uploading it, so a caller
+    // that knows which experts are coming can prepare the cache ahead of time.
+    // the slot is taken from the LRU head exactly like a miss in plan().
+    // returns the slot the expert now owns, or -1 if it already had one.
+    int32_t reserve(int32_t il, int32_t e) {
+        int32_t * slots = slot_map[il];
+        if (slots[e] >= 0) {
+            touch(slots[e]);
+            return -1;
+        }
+        const int32_t s = head;
+        if (key_of[s] >= 0) {
+            slot_map[key_of[s] / n_expert][key_of[s] % n_expert] = -1;
+        }
+        key_of[s] = il*n_expert + e;
+        slots[e] = s;
+        touch(s);
+        return s;
+    }
 };
 
