+static int32_t llama_moe_env_int(const char * name, int32_t dflt) {
+    const char * v = getenv(name);
+    if (v == nullptr || *v == '\0') {
+        return dflt;
+    }
+    return (int32_t) strtol(v, nullptr, 10);
+}
+
+// vipera: routing-aware prefetch table.
+//
+// The router only reveals the experts of a layer when that layer's split is about
+// to run, so llama.cpp has no lead time to hide an expert upload behind: the cache
+// is filled strictly on demand. A table learned offline from a routing trace (see
+// vipera's manifest) predicts which experts the *next* layers are likely to use, and
+// this file is that table:
+//
+//   # comment
+//   <layer index>  <expert>,<expert>,...     experts most likely first
+//
+// Set LLAMA_MOE_PREFETCH=<path> to enable it; LLAMA_MOE_PREFETCH_DEPTH (default 1)
+// is how many layers ahead to prefetch, LLAMA_MOE_PREFETCH_TOP (default 0 = all)
+// limits each layer to its first N candidates.
+static std::vector<std::vector<int32_t>> llama_moe_prefetch_table(const char * path) {
+    std::vector<std::vector<int32_t>> res;
+    if (path == nullptr) {
+        return res;
+    }
+    FILE * fp = fopen(path, "r");
+    if (fp == nullptr) {
+        LLAMA_LOG_WARN("%s: cannot open prefetch table %s\n", __func__, path);
+        return res;
+    }
+    char line[4096];
+    while (fgets(line, sizeof(line), fp) != nullptr) {
+        char * p = line;
+        while (*p == ' ' || *p == '\t') {
+            ++p;
+        }
+        if (*p == '#' || *p == '\n' || *p == '\r' || *p == '\0') {
+            continue;
+        }
+        char * end = nullptr;
+        const long il = strtol(p, &end, 10);
+        if (end == p || il < 0) {
+            continue;
+        }
+        p = end;
+        while (*p == ' ' || *p == '\t' || *p == ':' || *p == ',') {
+            ++p;
+        }
+        std::vector<int32_t> ids;
+        while (*p != '\0' && *p != '\n' && *p != '\r' && *p != '#') {
+            const long e = strtol(p, &end, 10);
+            if (end == p) {
+                ++p;
+                continue;
+            }
+            ids.push_back((int32_t) e);
+            p = end;
+        }
+        if (ids.empty()) {
+            continue;
+        }
+        if ((size_t) il >= res.size()) {
+            res.resize(il + 1);
+        }
+        res[il] = std::move(ids);
+    }
+    fclose(fp);
+    return res;
+}
+
 }
 
